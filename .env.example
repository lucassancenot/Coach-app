# Copie ce fichier en .env.local et remplis les valeurs.
# Sans STRAVA_CLIENT_ID, l'app tourne en mode démo (pas de connexion).

# Base de données : fichier local par défaut. En ligne : URL + jeton Turso.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Strava : https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Mot de passe inventé, utilisé pour valider le webhook
STRAVA_VERIFY_TOKEN=
# Optionnel : ton ID athlète Strava (sinon, le premier compte connecté devient propriétaire)
ALLOWED_ATHLETE_ID=

# Chaîne aléatoire de 32+ caractères pour signer la session
SESSION_SECRET=

# Coach IA : https://console.anthropic.com
ANTHROPIC_API_KEY=
